/* app.wxss */

page {
  font-family: 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333333;
}

/* 底部菜单栏样式 */
/* 微信小程序tabBar默认样式覆盖 */
.tab-bar .tab-bar-item .tab-bar-label {
  font-weight: 600 !important;
}

/* 通用tabBar样式覆盖 */
.tabbar-item text {
  font-weight: 600 !important;
}

/* 主色调 */
.primary-color {
  color: #003183;
}

.primary-bg {
  background-color: #003183;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #003183;
  color: white;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-secondary {
  background-color: white;
  color: #003183;
  border: 1rpx solid #003183;
  border-radius: 8rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

/* 通用容器样式 */
.container {
  width: 100%;
  min-height: 100vh;
  padding: 0 20rpx;
  box-sizing: border-box;
}
