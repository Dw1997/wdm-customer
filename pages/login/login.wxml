<view class="page">
  <!-- 登录头部 -->
  <view class="login-header">
    <view class="logo-wrapper">
      <text class="logo-text">味都美</text>
    </view>
    <text class="app-name">味都美副食商城</text>
    <text class="welcome-text">欢迎回来</text>
  </view>

  <!-- 登录表单 -->
  <view class="login-form">
    <view class="login-desc">
      <mp-icon icon="info" color="#003183" size="20"></mp-icon>
      <text>为了提供配送服务，请授权手机号</text>
    </view>
    
    <!-- 手机号授权按钮 -->
    <button 
      class="weui-btn weui-btn_primary phone-login-btn" 
      open-type="getPhoneNumber" 
      bindgetphonenumber="onGetPhoneNumber" 
      loading="{{loading}}"
    >
      <text>微信一键授权手机号</text>
    </button>
  </view>
</view>
