/* login.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 登录头部 */
.login-header {
  background: linear-gradient(135deg, #003183 0%, #4a90e2 100%);
  padding: 100rpx 40rpx 80rpx;
  text-align: center;
}

.logo-wrapper {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 30rpx;
  border-radius: 50%;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 49, 131, 0.2);
}

.logo {
  width: 120rpx;
  height: 120rpx;
}

.app-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.welcome-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 登录表单 */
.login-form {
  margin: -40rpx 40rpx 40rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.login-desc {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
  padding: 24rpx;
  background-color: #f0f5ff;
  border-radius: 12rpx;
  border-left: 4rpx solid #003183;
}

.login-desc mp-icon {
  flex-shrink: 0;
}

.login-desc text {
  font-size: 26rpx;
  color: #003183;
  line-height: 1.6;
}

/* 手机号登录按钮 */
.phone-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(24, 144, 255, 0.3);
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn:active {
  background: linear-gradient(135deg, #096dd9 0%, #1890ff 100%);
  transform: scale(0.98);
}
