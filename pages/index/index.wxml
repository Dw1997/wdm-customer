<!--index.wxml-->
<view class="page">
  <!-- 搜索栏 -->
  <view class="search-container">
    <view class="search-box">
      <input 
        class="search-input" 
        type="text" 
        placeholder="输入你想搜索的物品" 
        value="{{keyword}}"
        bindinput="onInput"
        bindfocus="onSearchFocus"
        bindconfirm="onSearch"
      />
      <view class="search-clear" wx:if="{{keyword}}" bindtap="clearInput">
        <mp-icon icon="close" color="#999999" size="28"></mp-icon>
      </view>
    </view>
  </view>

  <!-- 轮播图 -->
  <swiper class="swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500">
    <swiper-item class="swiper-item" wx:for="{{banners}}" wx:key="id">
      <image class="swiper-image" src="{{item.image}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 推荐商品 -->
  <view class="page__bd">
    <view class="weui-cells__title">推荐商品</view>
    <view class="goods-list">
      <view class="goods-card" wx:for="{{recommendedGoods}}" wx:key="id">
        <view class="goods-image-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
          <image class="goods-image" src="{{item.image}}" mode="aspectFill"></image>
        </view>
        <view class="goods-info">
          <view class="goods-name-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
            <text class="goods-name">{{item.name}}</text>
          </view>
          <view class="goods-price-row">
            <text class="goods-price">¥{{item.price}}/{{item.unit}}</text>
            <text class="goods-specs" wx:if="{{item.specs}}">({{item.specs}})</text>
          </view>
          <view class="goods-actions">
            <button class="weui-btn mini-btn action-btn minus" size="mini" bindtap="decreaseCount" data-id="{{item.id}}">-</button>
            <text class="goods-count">{{item.count || 0}}</text>
            <picker class="unit-picker" bindchange="changeUnit" data-id="{{item.id}}" value="{{item.units.indexOf(item.unit)}}" range="{{item.units}}">
              <view class="picker-view">{{item.unit}} ▼</view>
            </picker>
            <button class="weui-btn mini-btn action-btn plus" size="mini" bindtap="increaseCount" data-id="{{item.id}}">+</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <mp-loading type="circle" tips="加载中..." show="{{loading}}"></mp-loading>

  <!-- 顶部提示 -->

  <!-- 搜索结果模态框（wx:if 确保隐藏时彻底移出DOM，避免 catchtouchmove 拦截页面滚动） -->
  <view wx:if="{{showSearchModal}}" class="search-modal show" catchtouchmove="true">
    <view class="modal-mask" bindtap="closeSearchModal" catchtouchmove="true"></view>
    <view class="modal-content" catchtouchmove="true">
      <view class="modal-header">
        <text class="modal-title">搜索结果</text>
        <view class="modal-close" bindtap="closeSearchModal">
          <mp-icon icon="close" color="#666666" size="32"></mp-icon>
        </view>
      </view>
      
      <scroll-view 
        class="result-list" 
        scroll-y="true"
        lower-threshold="300"
        bindscrolltolower="loadMoreSearch"
        style="-webkit-overflow-scrolling: touch; overflow-y: auto;"
      >
        <!-- 加载中 -->
        <view class="loading-state" wx:if="{{searchLoading}}">
          <mp-loading type="circle" size="40"></mp-loading>
          <text>搜索中...</text>
        </view>

        <!-- 搜索结果 -->
        <view class="result-items" wx:if="{{!searchLoading && searchResults.length > 0}}">
          <view 
            class="search-goods-item" 
            wx:for="{{searchResults}}" 
            wx:key="id"
          >
            <!-- 左侧图片 -->
            <view class="search-goods-image" bindtap="goToGoodsDetail" data-id="{{item.id}}">
              <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"></image>
              <view wx:else class="goods-placeholder">
                <mp-icon icon="photo" color="#cccccc" size="48"></mp-icon>
              </view>
            </view>
            <!-- 右侧信息 -->
            <view class="search-goods-info">
              <!-- 第一行: 商品名称 -->
              <view class="search-goods-name" bindtap="goToGoodsDetail" data-id="{{item.id}}">
                {{item.name}}
              </view>
              <!-- 第二行: SKU选择 -->
              <view class="search-goods-sku">
                <view class="sku-options">
                  <view 
                    class="sku-option {{item.selectedSku.sku_id === sku.sku_id ? 'selected' : ''}}" 
                    wx:for="{{item.skus}}" 
                    wx:for-item="sku" 
                    wx:key="sku_id"
                    bindtap="onSkuClick"
                    data-goods-id="{{item.id}}"
                    data-sku-id="{{sku.sku_id}}"
                  >
                    <text class="sku-price">¥{{sku.sku_selling_price}}</text>
                    <text class="sku-unit">/{{sku.sku_unit}}</text>
                    <text wx:if="{{sku.sku_specification && sku.sku_specification !== 'None'}}" class="sku-spec">{{sku.sku_specification}}</text>
                  </view>
                </view>
              </view>
              <!-- 第三行: 操作栏 -->
              <view class="search-goods-actions">
                <button 
                  class="action-btn minus" 
                  size="mini" 
                  bindtap="decreaseSearchCount" 
                  data-id="{{item.id}}"
                >-</button>
                <text class="action-count">{{item.count || 0}}</text>
                <text class="action-unit">{{item.selectedSku ? item.selectedSku.sku_unit : item.skus[0].sku_unit}}</text>
                <button 
                  class="action-btn plus" 
                  size="mini" 
                  bindtap="increaseSearchCount" 
                  data-id="{{item.id}}"
                >+</button>
              </view>
            </view>
          </view>
          
          <!-- 加载更多 -->
          <view class="load-more" wx:if="{{searchHasMore}}">
            <mp-loading type="circle" size="24" wx:if="{{searchLoadingMore}}"></mp-loading>
            <text wx:else>上拉加载更多</text>
          </view>
          <view class="no-more" wx:if="{{!searchHasMore && searchResults.length > 0}}">
            <text>没有更多了</text>
          </view>
        </view>

        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{!searchLoading && searchResults.length === 0 && searched}}">
          <mp-icon icon="info" color="#cccccc" size="64"></mp-icon>
          <text class="empty-text">未找到相关产品</text>
          <text class="empty-subtext">换个关键词试试吧</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
