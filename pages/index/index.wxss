/* index.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page__bd {
  padding: 0 20rpx 40rpx;
}

/* 搜索栏样式 */
.search-container {
  background-color: #003183;
  padding: 20rpx 30rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  position: relative;
}

.search-input {
  flex: 1;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 28rpx;
  color: #333333;
  border: none;
  background: transparent;
  outline: none;
  box-sizing: border-box;
  min-width: 0;
  -webkit-appearance: none;
  appearance: none;
  padding: 0 44rpx 0 24rpx;
}

.search-input::placeholder {
  color: #999999;
}

.search-input:focus {
  outline: none;
  border: none;
  -webkit-appearance: none;
  appearance: none;
}

.search-clear {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 8rpx;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

/* 轮播图样式 */
.swiper {
  width: 100%;
  height: 400rpx;
  margin-bottom: 20rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 推荐商品列表 */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.goods-image-wrapper {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.goods-image {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name-wrapper {
  margin-bottom: 10rpx;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
}

.goods-price-row {
  margin-bottom: 16rpx;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.goods-specs {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
}

.goods-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  width: 56rpx !important;
  height: 56rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 50% !important;
  border: 2rpx solid transparent !important;
}

.action-btn.plus {
  background-color: #003183 !important;
  color: #ffffff !important;
}

.action-btn.minus {
  background-color: #f5f5f5 !important;
  color: #666666 !important;
  border-color: #003183 !important;
}

.goods-count {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  min-width: 40rpx;
  text-align: center;
}

.unit-picker {
  flex: 1;
}

.picker-view {
  font-size: 28rpx;
  color: #666666;
  padding: 8rpx 16rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
}

/* 加载动画 */
.weui-loadmore {
  margin-top: 40rpx;
}

/* 搜索结果模态框 */
.search-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.search-modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 66.67vh;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.search-modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  padding: 8rpx;
}

/* 结果列表 */
.result-list {
  flex: 1;
  padding: 20rpx 30rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-state text {
  font-size: 28rpx;
  color: #999999;
  margin-top: 20rpx;
}

/* 搜索商品项 - 新布局 */
.search-goods-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.search-goods-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.search-goods-image image {
  width: 100%;
  height: 100%;
}

.search-goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 180rpx;
}

/* 第一行: 商品名称 */
.search-goods-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 第二行: SKU选择 */
.search-goods-sku {
  margin: 12rpx 0;
}

.sku-options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.sku-option {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  cursor: pointer;
}

.sku-option.selected {
  background-color: #e6f7ff;
  border-color: #003183;
}

.sku-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
  margin-right: 6rpx;
}

.sku-unit {
  font-size: 28rpx;
  color: #666666;
  margin-right: 10rpx;
}

.sku-spec {
  font-size: 26rpx;
  color: #999999;
  margin-left: 10rpx;
  padding-left: 10rpx;
  border-left: 1rpx solid #e8e8e8;
}

/* 第三行: 操作栏 */
.search-goods-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.search-goods-actions .action-btn {
  width: 60rpx !important;
  height: 60rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  font-size: 36rpx !important;
  font-weight: 700 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-radius: 50% !important;
  border: 2rpx solid transparent !important;
}

.search-goods-actions .action-btn.minus {
  background-color: #f5f5f5 !important;
  color: #666666 !important;
  border-color: #d9d9d9 !important;
}

.search-goods-actions .action-btn.plus {
  background-color: #003183 !important;
  color: #ffffff !important;
}

.search-goods-actions .action-count {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  min-width: 48rpx;
  text-align: center;
}

.search-goods-actions .action-unit {
  font-size: 30rpx;
  color: #666666;
  margin-right: 6rpx;
}

/* 加载更多 */
.load-more,
.no-more {
  text-align: center;
  padding: 40rpx 0;
}

.load-more text,
.no-more text {
  font-size: 26rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #666666;
  margin-top: 30rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
}
