<!--cart.wxml-->
<view class="page">
  <!-- 购物车为空 -->
  <view wx:if="{{cart.length === 0}}" class="empty-state">
    <mp-icon icon="info" color="#999999" size="80"></mp-icon>
    <text class="empty-text">购物车空空如也</text>
    <button class="weui-btn weui-btn_primary" bindtap="goToIndex">去逛逛</button>
  </view>

  <!-- 购物车商品列表 -->
  <view wx:else class="page__bd">
    <view class="cart-list">
      <view class="cart-item" wx:for="{{cart}}" wx:key="id">
        <view class="checkbox-wrapper">
          <mp-checkbox checked="{{item.checked}}" bindchange="toggleChecked" data-id="{{item.id}}" ext-class="cart-checkbox" label=""></mp-checkbox>
        </view>
        <view class="goods-image-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
          <image class="goods-image" src="{{item.image}}" mode="aspectFill"></image>
        </view>
        <view class="goods-info">
          <text class="goods-name" bindtap="goToGoodsDetail" data-id="{{item.id}}">{{item.name}}</text>
          <view class="goods-price-row">
            <text class="goods-count-info">{{item.count}}</text>
            <text class="goods-unit-info">{{item.unit}}</text>
            <text class="goods-asterisk">*</text>
            <text class="goods-price-info">{{item.price}}元/{{item.unit}}</text>
            <text class="goods-equal">=</text>
            <text class="goods-total">{{item.totalPrice}}元</text>
          </view>
          <view class="goods-bottom">
            <view class="goods-actions">
              <button class="weui-btn mini-btn action-btn" size="mini" bindtap="decreaseCount" data-id="{{item.id}}" data-sku-id="{{item.skuId}}">-</button>
              <text class="goods-count">{{item.count}}</text>
              <text class="goods-unit">{{item.unit}}</text>
              <button class="weui-btn mini-btn action-btn" size="mini" bindtap="increaseCount" data-id="{{item.id}}" data-sku-id="{{item.skuId}}">+</button>
            </view>
            <button class="weui-btn mini-btn delete-btn" size="mini" bindtap="deleteItem" data-id="{{item.id}}" data-sku-id="{{item.skuId}}">删除</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view wx:if="{{cart.length > 0}}" class="cart-footer">
    <view class="footer-left">
      <mp-checkbox-group bindchange="toggleAllChecked">
        <mp-checkbox checked="{{allChecked}}" label="全选"></mp-checkbox>
      </mp-checkbox-group>
    </view>
    <view class="footer-right">
      <view class="total-info">
        <text class="total-label">合计：</text>
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
      <button class="weui-btn weui-btn_primary checkout-btn" bindtap="submitOrder">
        结算({{selectedCount}})
      </button>
    </view>
  </view>
</view>