/* cart.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.page__bd {
  padding: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999999;
  margin: 40rpx 0 60rpx;
}

/* 购物车列表 */
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 购物车商品项 - WeUI风格 */
.cart-item {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.checkbox-wrapper {
  margin-right: 20rpx;
}

.goods-image-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.goods-image {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 12rpx;
}

.goods-price-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f0ff 100%);
  border-radius: 12rpx;
}

.goods-count-info {
  font-size: 28rpx;
  font-weight: 600;
  color: #003183;
}

.goods-unit-info {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  margin: 0 8rpx;
}

.goods-asterisk {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b6b;
  margin: 0 8rpx;
}

.goods-price-info {
  font-size: 28rpx;
  font-weight: 600;
  color: #003183;
  margin: 0 8rpx;
}

.goods-equal {
  font-size: 28rpx;
  font-weight: 700;
  color: #003183;
  margin: 0 8rpx;
}

.goods-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #003183;
  text-shadow: 0 2rpx 4rpx rgba(0, 49, 131, 0.15);
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  gap: 16rpx;
}

.goods-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  flex: 1;
}

.goods-actions .goods-count {
  font-size: 32rpx;
  font-weight: 700;
  color: #003183;
  min-width: 48rpx;
  text-align: center;
}

.goods-actions .goods-unit {
  font-size: 28rpx;
  font-weight: 700;
  color: #003183;
  margin-left: 4rpx;
  margin-right: 4rpx;
}

.delete-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%) !important;
  color: white !important;
  font-size: 24rpx !important;
  padding: 10rpx 24rpx !important;
  border-radius: 12rpx !important;
  margin: 0 !important;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.3);
  transition: all 0.3s ease;
}

.delete-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(255, 77, 79, 0.4);
}

.delete-btn::after {
  border: none;
}

.action-btn {
  width: 52rpx !important;
  height: 52rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 52rpx !important;
  font-size: 28rpx !important;
  font-weight: 600;
  color: #003183 !important;
  background-color: #f0f5ff !important;
  border: 2rpx solid #003183 !important;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.goods-count {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  min-width: 48rpx;
  text-align: center;
}

.goods-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #003183;
}

/* 底部结算栏 - WeUI风格 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.footer-left {
  display: flex;
  align-items: center;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.total-info {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 28rpx;
  color: #666666;
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #003183;
}

.checkout-btn {
  background-color: #003183 !important;
  color: white !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  padding: 20rpx 48rpx !important;
  border-radius: 40rpx !important;
  margin: 0 !important;
}

.checkout-btn::after {
  border: none;
}

/* WeUI复选框样式覆盖 */
.weui-checkbox {
  --weui-BRAND: #003183;
}

/* 购物车复选框样式 */
.cart-checkbox {
  transform: scale(1.3);
  margin: 0;
}

.cart-checkbox .weui-checkbox__input-box {
  border: 2rpx solid #003183;
  border-radius: 8rpx;
  width: 40rpx;
  height: 40rpx;
}

.cart-checkbox.weui-checkbox__checked .weui-checkbox__input-box {
  background-color: #003183;
  border-color: #003183;
}

.cart-checkbox .weui-checkbox__icon {
  width: 24rpx;
  height: 24rpx;
}

/* 滑动删除按钮样式 */
.weui-slidecell__buttons {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 20rpx;
}

.weui-slidecell__btn {
  background-color: #ff4d4f;
  color: white;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.weui-slidecell {
  background-color: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}
