<!--pages/goodsDetail/goodsDetail.wxml-->
<view class="page">
  <!-- 商品图片轮播 -->
  <swiper class="detail-swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500" circular>
    <swiper-item wx:for="{{goods.images}}" wx:key="index">
      <image class="swiper-image" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 商品信息卡片 -->
  <view class="info-card">
    <view class="name-row">
      <text class="detail-name">{{goods.name}}</text>
      <view class="share-btn" bindtap="shareGoods">
        <mp-icon icon="share" color="#666666" size="32"></mp-icon>
        <text class="share-text">分享</text>
      </view>
    </view>
    <view class="tags-row">
      <view class="tag" wx:for="{{goods.tags}}" wx:key="index">{{item}}</view>
    </view>
    
    <!-- SKU 列表 -->
    <view class="sku-list" wx:if="{{goods && goods.skus && goods.skus.length > 0}}">
      <view class="sku-list-title">规格价格：</view>
      <view class="sku-list-items">
        <view class="sku-list-item" wx:for="{{goods.skus}}" wx:key="{{item.sku_id}}">
          <text class="sku-list-price">￥{{item.sku_selling_price}}元</text>
          <text class="sku-list-unit" wx:if="{{item.sku_unit}}">/{{item.sku_unit}}</text>
          <text class="sku-list-spec" wx:if="{{item.sku_unit && item.sku_specification && item.sku_specification !== 'None'}}">|{{item.sku_specification}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 商品详情 -->
  <view class="detail-section">
    <view class="section-header">
      <view class="section-line"></view>
      <text class="section-title">商品详情</text>
      <view class="section-line"></view>
    </view>
    <view class="detail-content">
      <text class="detail-desc">{{goods.description}}</text>
      <image wx:for="{{goods.detailImages}}" wx:key="index" src="{{item}}" mode="widthFix" class="detail-image"></image>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 120rpx;"></view>

  <!-- 底部操作栏 -->
  <view class="detail-bottom">
    <view class="bottom-left">
      <view class="icon-btn" bindtap="showCartPreview">
        <image class="cart-icon" src="/images/cart.png" mode="aspectFit"></image>
        <text class="icon-text">购物车</text>
        <mp-badge content="{{cartCount}}" wx:if="{{cartCount > 0}}" class="cart-badge"></mp-badge>
      </view>
    </view>
    <view class="bottom-right">
      <button class="weui-btn weui-btn_primary add-cart-btn" bindtap="showAddCartDialog">加入购物车</button>
      <button class="weui-btn weui-btn_warn buy-btn" bindtap="showBuyNowDialog">立即购买</button>
    </view>
  </view>

  <!-- 数量选择模态框 -->
  <view wx:if="{{showQuantityDialog}}" class="modal-overlay" bindtap="closeQuantityDialog">
    <view class="modal-content" catchtap="noop">
      <view class="dialog-header">
        <view class="dialog-title">选择规格</view>
        <view class="dialog-close" bindtap="closeQuantityDialog">
          <mp-icon icon="close" color="#666666" size="32"></mp-icon>
        </view>
      </view>
      <view class="goods-info-section">
        <image class="dialog-goods-image" src="{{goods.images[0]}}" mode="aspectFill"></image>
        <view class="dialog-goods-info">
          <text class="dialog-goods-name">{{goods.name}}</text>
          <view class="dialog-price">
            <text class="dialog-price-symbol">¥</text>
            <text class="dialog-price-value">{{goods.price}}</text>
            <text class="dialog-price-unit">/{{goods.unit}}</text>
            <text class="dialog-price-spec" wx:if="{{goods.specs && goods.specs !== 'None'}}">|{{goods.specs}}</text>
          </view>
        </view>
      </view>
      <view class="quantity-section">
        <view class="quantity-row">
          <text class="dialog-label">数量：</text>
          <view class="quantity-input-wrapper">
            <button class="weui-btn mini-btn qty-btn" size="mini" bindtap="dialogDecreaseCount">-</button>
            <text class="qty-count">{{dialogCount}}</text>
            <button class="weui-btn mini-btn qty-btn" size="mini" bindtap="dialogIncreaseCount">+</button>
          </view>
        </view>
        <view class="quantity-row">
          <text class="dialog-label">选择规格：</text>
          <view class="sku-options">
            <view 
              wx:for="{{goods.skus}}" 
              wx:key="sku_id"
              class="sku-option {{dialogUnit === item.sku_unit ? 'selected' : ''}}" 
              bindtap="dialogChangeSku" 
              data-unit="{{item.sku_unit}}" 
              data-sku-id="{{item.sku_id}}"
              data-price="{{item.sku_selling_price}}"
            >
              <text class="sku-price">¥{{item.sku_selling_price}}</text>
              <text class="sku-unit">/{{item.sku_unit}}</text>
              <text class="sku-spec">| {{item.sku_specification === 'None' ? '' : item.sku_specification}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="dialog-footer">
        <button class="weui-btn weui-btn_primary add-cart-dialog-btn" bindtap="confirmQuantityDialog">
          {{currentAction === 'addCart' ? '加入购物车' : '立即购买'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 购物车预览模态框 -->
  <view wx:if="{{showCartPreviewDialog}}" class="modal-overlay" bindtap="closeCartPreview">
    <view class="modal-content cart-preview-modal" catchtap="noop">
      <view class="dialog-header">
        <view class="dialog-title">购物车 ({{cartCount}}件商品)</view>
        <view class="dialog-close" bindtap="closeCartPreview">
          <mp-icon icon="close" color="#666666" size="32"></mp-icon>
        </view>
      </view>
      <scroll-view class="cart-preview-list" scroll-y="true" enhanced="true" show-scrollbar="true" catchtouchmove="noop">
        <block wx:if="{{cartItems.length === 0}}">
          <view class="cart-preview-empty">
            <mp-icon icon="info" color="#999999" size="64"></mp-icon>
            <text class="cart-preview-empty-text">购物车是空的</text>
          </view>
        </block>
        <block wx:else>
          <view class="cart-preview-item" wx:for="{{cartItems}}" wx:key="id">
            <view class="goods-image-wrapper">
              <image wx:if="{{item.image}}" class="cart-preview-image" src="{{item.image}}" mode="aspectFill"></image>
              <view wx:else class="goods-placeholder">
                <mp-icon icon="photo" color="#cccccc" size="48"></mp-icon>
              </view>
            </view>
            <view class="cart-preview-info">
              <text class="cart-preview-name">{{item.name}}</text>
              <view class="cart-preview-price-row">
                <text class="cart-preview-count-info">{{item.count}}</text>
                <text class="cart-preview-unit-info">{{item.sku_unit}}</text>
                <text class="cart-preview-asterisk">*</text>
                <text class="cart-preview-price-info">{{item.sku_selling_price}}元/{{item.sku_unit || item.unit}}</text>
                <text class="cart-preview-equal">=</text>
                <text class="cart-preview-total-info">{{item.count*item.sku_selling_price}}元</text>
              </view>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="dialog-footer cart-preview-footer">
        <view class="cart-preview-total-info">
          <text class="cart-preview-total-label">合计：</text>
          <text class="cart-preview-total-price">¥{{cartTotalPrice}}</text>
        </view>
        <button class="weui-btn weui-btn_primary go-cart-btn" bindtap="goToCart">去购物车结算</button>
      </view>
    </view>
  </view>

  <!-- 分享弹窗 -->
  <mp-half-screen-dialog show="{{showShareDialog}}" bindclose="closeShareDialog" title="分享给好友">
    <view class="share-options">
      <view class="share-option" bindtap="shareToFriend">
        <view class="share-icon wechat-icon">
          <text class="share-icon-text">微</text>
        </view>
        <text>微信好友</text>
      </view>
      <view class="share-option" bindtap="shareToTimeline">
        <view class="share-icon moments-icon">
          <text class="share-icon-text">圈</text>
        </view>
        <text>朋友圈</text>
      </view>
    </view>
  </mp-half-screen-dialog>
</view>