.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 轮播图样式 */
.detail-swiper {
  width: 100%;
  height: 600rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* 商品信息卡片 */
.info-card {
  background-color: #ffffff;
  margin: -40rpx 30rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.price-wrapper {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 32rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.detail-price {
  font-size: 56rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin: 0 4rpx;
}

.detail-unit {
  font-size: 28rpx;
  color: #999999;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.share-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.share-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 4rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 20rpx;
  display: block;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: #003183;
  background-color: #e6f7ff;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

/* SKU 列表样式 */
.sku-list {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.sku-list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.sku-list-items {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-list-item {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.sku-list-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff4d4f;
  margin-right: 4rpx;
}

.sku-list-unit {
  font-size: 32rpx;
  font-weight: 600;
  color: #003183;
  margin-right: 4rpx;
}

.sku-list-spec {
  font-size: 24rpx;
  color: #999999;
}

/* 规格卡片 */
.specs-card {
  margin: 0 30rpx 20rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.cell-label {
  font-size: 28rpx;
  color: #999999;
  min-width: 100rpx;
}

.stock-text {
  color: #52c41a;
  font-weight: 500;
}

.free-shipping {
  color: #ff4d4f;
  font-weight: 500;
}

/* 商品详情 */
.detail-section {
  margin: 0 30rpx 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.section-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #dddddd, transparent);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #666666;
  margin: 0 30rpx;
}

.detail-content {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.detail-desc {
  font-size: 30rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 30rpx;
  display: block;
}

.detail-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

/* 底部操作栏 */
.detail-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 16rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.bottom-left {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.icon-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.icon-text {
  font-size: 20rpx;
  color: #666666;
  margin-top: 4rpx;
}

.cart-icon {
  width: 48rpx;
  height: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -15rpx;
  right: -15rpx;
  transform: scale(0.8);
  transform-origin: right top;
}

.icon-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.bottom-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-cart-btn {
  background-color: #003183 !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  padding: 20rpx 32rpx !important;
  border-radius: 32rpx !important;
  margin: 0 !important;
}

.add-cart-btn::after {
  border: none;
}

.buy-btn {
  background-color: #ff4d4f !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  padding: 20rpx 32rpx !important;
  border-radius: 32rpx !important;
  margin: 0 !important;
}

.buy-btn::after {
  border: none;
}

/* 分享选项 */
.share-options {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 60rpx;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.share-option text {
  font-size: 28rpx;
  color: #333333;
}

/* WeUI Cells 样式覆盖 */
.weui-cells {
  background-color: transparent !important;
}

.weui-cell {
  padding: 30rpx 24rpx !important;
}

.weui-cell__bd {
  font-size: 30rpx;
  color: #333333;
}

/* 自定义模态框样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: flex-end;
  align-items: flex-end;
  z-index: 9999;
  animation: fadeIn 0.3s ease-in-out;
}

.modal-content {
  width: 100%;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  animation: slideUp 0.3s ease-in-out;
  overflow: hidden;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 半屏对话框样式 */
.quantity-dialog-content {
  padding: 0;
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.dialog-close {
  padding: 10rpx;
}

.goods-info-section {
  display: flex;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #f9f9f9;
}

.dialog-goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.dialog-goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dialog-goods-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 20rpx;
  line-height: 50rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dialog-price {
  display: flex;
  align-items: baseline;
}

.dialog-price-symbol {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 700;
  margin-right: 4rpx;
}

.dialog-price-value {
  font-size: 48rpx;
  color: #ff4d4f;
  font-weight: 700;
  margin-right: 4rpx;
}

.dialog-price-unit {
  font-size: 32rpx;
  color: #666666;
  font-weight: 600;
}

.dialog-price-spec {
  font-size: 28rpx;
  color: #999999;
  margin-left: 4rpx;
}

.quantity-section {
  padding: 30rpx;
  background-color: #ffffff;
}

.quantity-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.quantity-row:last-child {
  margin-bottom: 0;
}

.dialog-label {
  font-size: 30rpx;
  color: #333333;
  min-width: 120rpx;
  font-weight: 600;
}

.quantity-input-wrapper {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 12rpx;
  gap: 16rpx;
}

.picker-view {
  font-size: 28rpx;
  color: #003183;
  background-color: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-weight: 600;
  min-width: 150rpx;
}

/* SKU选择样式 */
.sku-options {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  flex: 1;
}

.sku-option {
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  cursor: pointer;
  flex-shrink: 0;
}

.sku-option.selected {
  background-color: #e6f7ff;
  border-color: #003183;
}

.sku-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #003183;
  margin-right: 4rpx;
}

.sku-unit {
  font-size: 26rpx;
  color: #666666;
}

.sku-spec {
  font-size: 22rpx;
  color: #999999;
  margin-left: 8rpx;
  white-space: nowrap;
}

/* 模态框内数量按钮 */
.qty-btn {
  width: 64rpx !important;
  height: 64rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 64rpx !important;
  font-size: 36rpx !important;
  font-weight: 700;
  color: #333333 !important;
  background-color: #ffffff !important;
  border-radius: 12rpx !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.qty-btn::after {
  border: none;
}

.qty-count {
  font-size: 36rpx;
  font-weight: 700;
  color: #003183;
  min-width: 80rpx;
  text-align: center;
  background-color: #ffffff;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.1);
}

.dialog-footer {
  padding: 30rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.add-cart-dialog-btn {
  background-color: #ff4d4f !important;
  color: #ffffff !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 12rpx !important;
}

.add-cart-dialog-btn::after {
  border: none;
}

