  margin-bottom: 16rpx;
}

.cart-preview-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.cart-preview-info {
  flex: 1;
