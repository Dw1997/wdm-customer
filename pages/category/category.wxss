.page {
  background-color: #f5f5f5;
  height: 100vh;
}

.category-container {
  display: flex;
  height: 100%;
}

/* 左侧分类列表 - WeUI风格 */
.category-left {
  width: 16.67%;
  background-color: #f8f8f8;
  height: 100%;
  border-right: 1rpx solid #e5e5e5;
}

.category-item {
  min-height: 120rpx;
  padding: 20rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #e5e5e5;
  transition: all 0.3s ease;
  background-color: #f8f8f8;
}

.category-item.active {
  background-color: #ffffff;
  border-left: 6rpx solid #003183;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  writing-mode: vertical-rl;
  text-orientation: upright;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  letter-spacing: 4rpx;
}

.category-item.active .category-name {
  color: #003183;
}

/* 右侧商品列表 */
.category-right {
  flex: 1;
  padding: 20rpx;
  height: 100%;
  box-sizing: border-box;
  background-color: #ffffff;
}

.category-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.category-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.goods-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 商品卡片 - WeUI风格 */
.goods-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: flex-start;
  transition: all 0.3s ease;
  border: 1rpx solid #f0f0f0;
}

.goods-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.goods-image-wrapper {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.goods-image {
  width: 100%;
  height: 100%;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 180rpx;
}

.goods-name-wrapper {
  margin-bottom: 12rpx;
}

.goods-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.goods-price-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.goods-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #003183;
}

.goods-specs {
  font-size: 26rpx;
  color: #999999;
  margin-left: 12rpx;
}

/* 操作按钮区域 */
.goods-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  width: 56rpx !important;
  height: 56rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: 56rpx !important;
  font-size: 32rpx !important;
  font-weight: 600;
  color: #003183 !important;
  background-color: #f0f5ff !important;
  border: 2rpx solid #003183 !important;
  border-radius: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.goods-count {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  min-width: 48rpx;
  text-align: center;
}

.unit-picker {
  flex: 1;
}

.picker-view {
  font-size: 28rpx;
  color: #003183;
  background-color: #f5f5f5;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-weight: 600;
}

/* WeUI徽章样式覆盖 */
.weui-badge {
  background-color: #003183 !important;
}
