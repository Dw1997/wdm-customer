<!--category.wxml-->
<view class="page">
  <view class="category-container">
    <!-- 左侧分类列表 -->
    <scroll-view class="category-left" scroll-y="true">
      <view class="category-item {{activeCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="switchCategory" data-id="{{item.id}}">
        <text class="category-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view class="category-right" scroll-y="true" bindscrolltolower="onReachBottom" bindscrolltoupper="onReachTop" upper-threshold="50">
      <view class="category-header">
        <text class="category-title">{{currentCategoryName}}</text>
        <mp-badge content="{{currentGoods.length}}" style="margin-left: 10rpx;" />
      </view>
      <view class="goods-list">
        <view class="goods-card" wx:for="{{currentGoods}}" wx:key="id">
          <view class="goods-image-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
            <image class="goods-image" src="{{item.image}}" mode="aspectFill"></image>
          </view>
          <view class="goods-info">
            <view class="goods-name-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
              <text class="goods-name">{{item.name}}</text>
            </view>
            <view class="goods-price-row">
              <text class="goods-price">¥{{item.price}}/{{item.unit}}</text>
              <text class="goods-specs" wx:if="{{item.specs}}">({{item.specs}})</text>
            </view>
            <view class="goods-actions">
              <button class="weui-btn mini-btn action-btn" size="mini" bindtap="decreaseCount" data-id="{{item.id}}">-</button>
              <text class="goods-count">{{item.count || 0}}</text>
              <picker class="unit-picker" mode="selector" range="{{item.units}}" bindchange="changeUnit" data-id="{{item.id}}" value="{{item.units.indexOf(item.unit)}}">
              <view class="picker-view">{{item.unit}} ▼</view>
            </picker>
              <button class="weui-btn mini-btn action-btn" size="mini" bindtap="increaseCount" data-id="{{item.id}}">+</button>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>