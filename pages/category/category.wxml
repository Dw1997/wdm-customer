<!--category.wxml-->
<view class="page">
  <view class="category-container">
    <!-- 左侧分类列表 -->
    <scroll-view 
      class="category-left" 
      scroll-y="true"
      scroll-with-animation
      scroll-into-view="{{activeMenuId}}"
      enhanced 
      show-scrollbar="{{false}}"
    >
      <view 
        wx:for="{{categories}}" 
        wx:key="id" 
        id="menu-{{item.id}}"
        class="category-item {{activeCategory === item.id ? 'active' : ''}}" 
        bindtap="switchCategory" 
        data-id="{{item.id}}"
      >
        <text class="category-name">{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view 
      class="category-right" 
      scroll-y="true" 
      bindscroll="onGoodsScroll"
      bindscrolltolower="onReachBottom"
      lower-threshold="100"
      enhanced 
      show-scrollbar="{{false}}"
    >
      <!-- 按分类区块渲染商品 -->
      <view wx:for="{{categories}}" wx:key="id" wx:for-item="cat">
        <view class="category-section" id="section-{{cat.id}}">
          <view class="category-header">
            <text class="category-title">{{cat.name}}</text>
            <mp-badge content="{{(cat.goods && cat.goods.length) || 0}}" style="margin-left: 10rpx;" />
          </view>
          <view class="goods-list">
            <view class="goods-card" wx:for="{{cat.goods}}" wx:key="id" wx:for-item="item">
              <view class="goods-image-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
                <image class="goods-image" src="{{item.image}}" mode="aspectFill"></image>
              </view>
              <view class="goods-info">
                <view class="goods-name-wrapper" bindtap="goToGoodsDetail" data-id="{{item.id}}">
                  <text class="goods-name">{{item.name}}</text>
                </view>
                <view class="goods-price-row">
                  <text class="goods-price">¥{{item.price}}/{{item.unit}}</text>
                  <text class="goods-specs" wx:if="{{item.specs}}">({{item.specs}})</text>
                </view>
                <view class="goods-actions">
                  <button class="weui-btn mini-btn action-btn minus" size="mini" bindtap="decreaseCount" data-id="{{item.id}}" data-category-id="{{cat.id}}">-</button>
                  <text class="goods-count">{{item.count || 0}}</text>
                  <picker class="unit-picker" mode="selector" range="{{item.units}}" bindchange="changeUnit" data-id="{{item.id}}" data-category-id="{{cat.id}}" value="{{item.units.indexOf(item.unit)}}">
                    <view class="picker-view">{{item.unit}} ▼</view>
                  </picker>
                  <button class="weui-btn mini-btn action-btn plus" size="mini" bindtap="increaseCount" data-id="{{item.id}}" data-category-id="{{cat.id}}">+</button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 加载状态 -->
      <view class="loading-tip" wx:if="{{loading}}">加载更多...</view>
      <view class="loading-tip" wx:if="{{noMore}}">没有更多了</view>
    </scroll-view>
  </view>
</view>
