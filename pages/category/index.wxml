<view class="page-root cat-page {{fontClass}}">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-ico">🔍</text>
      <input
        class="search-input"
        placeholder="搜商品名 / 货号（如 花椒、白糖）"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <view wx:if="{{keyword}}" class="clear-btn" bindtap="onClearSearch">×</view>
    </view>
  </view>

  <!-- 审核 / 未登录提示横幅 -->
  <view wx:if="{{noticeText}}" class="notice-bar">
    <text class="notice-txt">{{noticeText}}</text>
    <view wx:if="{{showLoginBtn}}" class="notice-btn" bindtap="goLogin">去登录</view>
  </view>

  <!-- 左分类 + 右商品 -->
  <view class="main-body">
    <scroll-view
      class="cat-nav"
      scroll-y
      scroll-into-view="{{activeCatNavId}}"
      scroll-with-animation
    >
      <view
        wx:for="{{categories}}"
        wx:key="id"
        id="cat-{{item.id}}"
        class="cat-item {{item.isFreq ? 'freq' : ''}} {{activeCatId === item.id && !keyword ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectCategory"
      >
        <text wx:if="{{item.isFreq}}" class="star">★</text>{{item.name}}
      </view>
    </scroll-view>

    <view class="goods-pane">
      <view class="pane-hd">
        <text class="pane-title">{{paneTitle}}</text>
        <text wx:if="{{!keyword}}" class="pane-sub">{{paneSub}}</text>
        <view wx:else class="back-cat-btn" bindtap="onClearSearch">返回分类</view>
      </view>

      <!-- 二级子分类横向胶囊栏 -->
      <scroll-view
        wx:if="{{!keyword && subCategories.length}}"
        class="sub-cat-scroll"
        scroll-x
        enable-flex
        show-scrollbar="{{false}}"
      >
        <view class="sub-cat-row">
          <view
            class="sub-pill {{activeSubCatId === '' ? 'active' : ''}}"
            data-id=""
            bindtap="onSelectSubCategory"
          >全部</view>
          <view
            wx:for="{{subCategories}}"
            wx:key="id"
            class="sub-pill {{activeSubCatId === item.id ? 'active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectSubCategory"
          >{{item.name}}</view>
        </view>
      </scroll-view>

      <!-- 模式一：全分类无级连续滑动（保活以保留滚动位置） -->
      <scroll-view
        hidden="{{isFilterMode}}"
        class="goods-scroll"
        scroll-y
        scroll-top="{{streamScrollTop}}"
        scroll-into-view="{{scrollIntoView}}"
        scroll-with-animation="{{scrollWithAnim}}"
        upper-threshold="120"
        lower-threshold="700"
        refresher-enabled="{{streamStartIdx > 0}}"
        refresher-threshold="36"
        refresher-triggered="{{prevRefreshing}}"
        bindrefresherrefresh="onLoadPrevCategory"
        bindscrolltoupper="onStreamScrollToUpper"
        bindscroll="onStreamScroll"
        bindscrolltolower="onStreamLoadMore"
        bindtouchstart="onStreamTouchStart"
        bindtouchend="onStreamTouchEnd"
      >
        <view
          wx:if="{{streamStartIdx > 0 && prevCatName}}"
          class="prev-cat-bar"
          bindtap="onClickPrevCategory"
        >
          <text>{{prevLoading ? '正在加载上一分类：' + prevCatName + '...' : '↑ 上一分类：' + prevCatName + '（上滑或点击查看）'}}</text>
        </view>

        <view wx:if="{{!streamLoading && !sections.length}}" class="empty-state">
          <view class="empty-title">暂无上架商品</view>
          <view class="empty-desc">可联系业务员咨询</view>
        </view>

        <view
          wx:for="{{sections}}"
          wx:for-item="sec"
          wx:key="id"
          id="sec-{{sec.id}}"
          class="sec-block"
          data-cat-id="{{sec.id}}"
        >
          <view class="sec-hd {{sec.isFreq ? 'freq' : ''}}">
            <text class="sec-title">{{sec.title}}</text>
            <text wx:if="{{sec.subTitle}}" class="sec-sub">{{sec.subTitle}}</text>
          </view>

          <view wx:for="{{sec.products}}" wx:key="spu_id" class="g-card">
            <view class="g-thumb" data-spu-id="{{item.spu_id}}" bindtap="goDetail">
              <text wx:if="{{item.is_frequent && !sec.isFreq}}" class="freq-tag">常购</text>
              <image wx:if="{{item.image_url}}" class="g-img" src="{{item.image_url}}" mode="aspectFill" lazy-load webp />
              <text wx:else class="g-placeholder">{{item.shortTitle}}</text>
            </view>

            <view class="g-info">
              <view data-spu-id="{{item.spu_id}}" bindtap="goDetail">
                <view class="g-name">{{item.name}}</view>
                <view class="g-spec">{{item.sku_count > 1 ? item.sku_count + '种规格可选' : item.default_sku_spec}} · {{item.code}}</view>
              </view>

              <view class="g-foot">
                <view wx:if="{{item.price !== null}}" class="g-price">
                  <text class="yen">¥</text>
                  <text class="num">{{item.priceText}}</text>
                  <text class="unit">{{item.sku_count > 1 ? '起' : '/' + item.default_sku_unit}}</text>
                </view>
                <view wx:else class="price-hidden-tag">{{item.priceHiddenText}}</view>

                <view wx:if="{{item.sku_count > 1}}" class="spec-btn" data-spu-id="{{item.spu_id}}" bindtap="openSpecSheet">
                  选规格
                  <view wx:if="{{item.cartCount > 0}}" class="spec-badge">{{item.cartCount}}</view>
                </view>
                <qty-stepper
                  wx:else
                  class="g-stepper"
                  value="{{item.cartCount}}"
                  label="{{item.name}}（{{item.default_sku_spec}}）"
                  data-sku-id="{{item.default_sku_id}}"
                  bind:change="onSingleQtyChange"
                />
              </view>
            </view>
          </view>

          <view wx:if="{{sec.loading}}" class="list-footer">加载中...</view>
        </view>

        <view wx:if="{{streamLoading && !sections.length}}" class="list-footer">加载中...</view>
        <view wx:elif="{{sections.length && streamHasMore}}" class="list-footer">
          {{streamLoading ? '正在加载更多商品...' : '继续下滑查看更多分类'}}
        </view>
        <view wx:elif="{{sections.length && !streamHasMore}}" class="list-footer">已浏览全部分类商品</view>
      </scroll-view>

      <!-- 模式二：搜索 / 二级子分类筛选 -->
      <scroll-view
        wx:if="{{isFilterMode}}"
        class="goods-scroll"
        scroll-y
        scroll-top="{{filterScrollTop}}"
        lower-threshold="600"
        bindscrolltolower="onFilterLoadMore"
      >
        <view wx:if="{{!filterLoading && !filterProducts.length}}" class="empty-state">
          <view class="empty-title">未找到相关商品</view>
          <view class="empty-desc">可更换关键词或联系业务员咨询</view>
        </view>

        <view wx:for="{{filterProducts}}" wx:key="spu_id" class="g-card">
          <view class="g-thumb" data-spu-id="{{item.spu_id}}" bindtap="goDetail">
            <text wx:if="{{item.is_frequent}}" class="freq-tag">常购</text>
            <image wx:if="{{item.image_url}}" class="g-img" src="{{item.image_url}}" mode="aspectFill" lazy-load webp />
            <text wx:else class="g-placeholder">{{item.shortTitle}}</text>
          </view>

          <view class="g-info">
            <view data-spu-id="{{item.spu_id}}" bindtap="goDetail">
              <view class="g-name">{{item.name}}</view>
              <view class="g-spec">{{item.sku_count > 1 ? item.sku_count + '种规格可选' : item.default_sku_spec}} · {{item.code}}</view>
            </view>

            <view class="g-foot">
              <view wx:if="{{item.price !== null}}" class="g-price">
                <text class="yen">¥</text>
                <text class="num">{{item.priceText}}</text>
                <text class="unit">{{item.sku_count > 1 ? '起' : '/' + item.default_sku_unit}}</text>
              </view>
              <view wx:else class="price-hidden-tag">{{item.priceHiddenText}}</view>

              <view wx:if="{{item.sku_count > 1}}" class="spec-btn" data-spu-id="{{item.spu_id}}" bindtap="openSpecSheet">
                选规格
                <view wx:if="{{item.cartCount > 0}}" class="spec-badge">{{item.cartCount}}</view>
              </view>
              <qty-stepper
                wx:else
                class="g-stepper"
                value="{{item.cartCount}}"
                label="{{item.name}}（{{item.default_sku_spec}}）"
                data-sku-id="{{item.default_sku_id}}"
                bind:change="onSingleQtyChange"
              />
            </view>
          </view>
        </view>

        <view wx:if="{{filterLoading}}" class="list-footer">加载中...</view>
        <view wx:elif="{{filterProducts.length && !filterHasMore}}" class="list-footer">
          <text>已显示全部商品</text>
          <view wx:if="{{!keyword && activeSubCatId}}" class="back-stream-btn" data-id="" bindtap="onSelectSubCategory">
            查看全部分类
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <spec-sheet
    visible="{{sheetVisible}}"
    product="{{sheetProduct}}"
    cartMap="{{cartMap}}"
    bind:close="closeSpecSheet"
    bind:change="onSheetQtyChange"
  />
</view>
