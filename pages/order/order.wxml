<!--order.wxml-->
<view class="page">
  <!-- 订单为空 -->
  <view wx:if="{{orders.length === 0}}" class="empty-state">
    <mp-icon icon="info" color="#999999" size="80"></mp-icon>
    <text class="empty-text">暂无订单</text>
    <button class="go-shopping-btn" bindtap="goToIndex">去逛逛</button>
  </view>

  <!-- 订单列表 -->
  <view wx:else class="page__bd">
    <view class="order-list">
      <view class="order-card" wx:for="{{orders}}" wx:key="id">
        <view class="order-header" bindtap="viewOrderDetail" data-id="{{item.id}}">
          <text class="order-time">下单时间：{{item.time}}</text>
          <view class="order-status-wrapper">
            <text class="header-status-text">{{item.status}}</text>
          </view>
        </view>
        <view class="order-status-row">
          <view class="status-item">
            <text class="status-label">支付状态：</text>
            <text class="status-value payment-status {{item.paymentStatus}}" wx:if="{{item.paymentStatus}}">{{item.paymentStatusText}}</text>
            <text class="status-value payment-status" wx:else>{{item.paymentStatusText}}</text>
          </view>
          <view class="status-item">
            <text class="status-label">配送状态：</text>
            <text class="status-value delivery-status {{item.deliveryStatus}}" wx:if="{{item.deliveryStatus}}">{{item.deliveryStatusText}}</text>
            <text class="status-value delivery-status" wx:else>{{item.deliveryStatusText}}</text>
          </view>
        </view>
        <view class="order-body">
          <view class="order-table">
            <view class="table-header">
              <text class="table-col table-col-name">商品名称</text>
              <text class="table-col table-col-count">数量</text>
              <text class="table-col table-col-unit">单位</text>
              <text class="table-col table-col-total">总价</text>
            </view>
            <view class="table-body">
              <view class="table-row" wx:for="{{item.items}}" wx:key="id">
                <text class="table-col table-col-name">{{item.name}}</text>
                <text class="table-col table-col-count">{{item.count}}</text>
                <text class="table-col table-col-unit">{{item.unit}}</text>
                <text class="table-col table-col-total">{{item.totalPrice || item.price * item.count}}</text>
              </view>
              <view class="table-row table-row-total">
                <text class="table-col table-col-name">订单总金额：</text>
                <text class="table-col table-col-count"></text>
                <text class="table-col table-col-unit"></text>
                <text class="table-col table-col-total total-price">¥{{item.totalPrice}}</text>
              </view>
            </view>
          </view>
        </view>
        <view class="order-actions">
          <button class="weui-btn weui-btn_primary mini-btn detail-btn" size="mini" bindtap="viewOrderDetail" data-id="{{item.id}}">查看详情</button>
          <button wx:if="{{item.deliveryStatus === 'pending_delivery'}}" class="weui-btn weui-btn_default mini-btn cancel-btn" size="mini" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <mp-loading type="circle" tips="加载中..." show="{{loading}}"></mp-loading>
</view>