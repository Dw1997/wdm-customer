<!--order.wxml-->
<view class="page">
  <!-- 订单为空 -->
  <view wx:if="{{orders.length === 0}}" class="empty-state">
    <mp-icon icon="info" color="#999999" size="80"></mp-icon>
    <text class="empty-text">暂无订单</text>
    <button class="weui-btn weui-btn_primary" bindtap="goToIndex">去逛逛</button>
  </view>

  <!-- 订单列表 -->
  <view wx:else class="page__bd">
    <view class="order-list">
      <view class="order-card" wx:for="{{orders}}" wx:key="id">
        <view class="order-header">
          <view class="order-info">
            <text class="order-time">下单时间：{{item.time}}</text>
            <text class="order-amount">金额：¥{{item.totalPrice}}</text>
          </view>
          <view class="order-status-wrapper">
            <view class="order-status-badge" style="background-color: {{getStatusColor(item.status)}};">
              <text class="order-status-text">{{item.status === '已送达' ? '已送' : '预送'}}</text>
            </view>
          </view>
        </view>
        <view class="order-body">
          <view class="order-payment-status">
            <text class="payment-status-label">订单支付状态：</text>
            <text class="payment-status-value">{{item.status}}</text>
          </view>
          <view class="order-table">
            <view class="table-header">
              <text class="table-col table-col-name">商品名称</text>
              <text class="table-col table-col-count">数量</text>
              <text class="table-col table-col-unit">单位</text>
              <text class="table-col table-col-total">总价</text>
            </view>
            <view class="table-body">
              <view class="table-row" wx:for="{{item.items}}" wx:key="id" bindtap="goToGoodsDetail" data-id="{{item.id}}">
                <text class="table-col table-col-name">{{item.name}}</text>
                <text class="table-col table-col-count">{{item.count}}</text>
                <text class="table-col table-col-unit">{{item.unit}}</text>
                <text class="table-col table-col-total">{{item.totalPrice || item.price * item.count}}元</text>
              </view>
            </view>
          </view>
          <view class="order-total">
            <text class="total-label">订单总金额：</text>
            <text class="total-price">¥{{item.totalPrice}}</text>
          </view>
        </view>
        <view class="order-actions">
          <button class="weui-btn weui-btn_primary mini-btn detail-btn" size="mini" bindtap="viewOrderDetail" data-id="{{item.id}}">查看详情</button>
          <button wx:if="{{item.status === '待处理' || item.status === '待支付' || item.status === '处理中'}}" class="weui-btn weui-btn_default mini-btn cancel-btn" size="mini" bindtap="cancelOrder" data-id="{{item.id}}">取消订单</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载提示 -->
  <mp-loading type="circle" tips="加载中..." show="{{loading}}"></mp-loading>
</view>