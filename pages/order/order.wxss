/* order.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page__bd {
  padding: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999999;
  margin: 40rpx 0 60rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 订单卡片 - WeUI风格 */
.order-card {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-info {
  display: flex;
  align-items: center;
}

.order-time {
  font-size: 28rpx;
  color: #666666;
}

.order-status-wrapper {
  display: flex;
  align-items: center;
}

/* 订单主体 */
.order-body {
  padding: 20rpx 24rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.order-item-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.order-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140rpx;
}

.order-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 12rpx;
}

.order-item-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-item-specs {
  font-size: 24rpx;
  color: #999999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  align-self: flex-start;
}

.order-item-price-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 12rpx 0;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #f0f5ff 0%, #e6f0ff 100%);
  border-radius: 12rpx;
}

.order-item-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #003183;
}

.order-item-unit {
  font-size: 28rpx;
  font-weight: 600;
  color: #666666;
  margin: 0 8rpx;
}

.order-item-asterisk {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b6b;
  margin: 0 8rpx;
}

.order-item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: #003183;
  margin: 0 8rpx;
}

.order-item-equal {
  font-size: 28rpx;
  font-weight: 700;
  color: #003183;
  margin: 0 8rpx;
}

.order-item-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #003183;
  text-shadow: 0 2rpx 4rpx rgba(0, 49, 131, 0.15);
}

/* 订单底部 */
.order-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background-color: #fafafa;
}

.order-total-label {
  font-size: 28rpx;
  color: #666666;
  margin-right: 12rpx;
}

.order-total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #003183;
}

/* 订单操作 */
.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.mini-btn {
  margin: 0 !important;
}

.mini-btn.weui-btn_primary {
  background-color: #003183 !important;
  color: #ffffff !important;
  font-weight: 600 !important;
  padding: 16rpx 32rpx !important;
  font-size: 28rpx !important;
  min-width: 160rpx;
}

.mini-btn.weui-btn_default {
  color: #666666 !important;
  border-color: #dddddd !important;
  font-weight: 600 !important;
  padding: 16rpx 32rpx !important;
  font-size: 28rpx !important;
  min-width: 160rpx;
}

.cancel-btn {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%) !important;
  border: 2rpx solid #dee2e6 !important;
  color: #6c757d !important;
  transition: all 0.3s ease;
}

.cancel-btn:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%) !important;
  transform: scale(0.98);
}

/* 订单状态徽章样式 */
.order-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  min-width: 120rpx;
}

.order-status-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

/* WeUI徽章样式 */
.weui-badge {
  background-color: #003183 !important;
}
