/* order.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page__bd {
  padding: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 60rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999999;
  margin: 40rpx 0 60rpx;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 订单卡片 - WeUI风格 */
.order-card {
  background-color: white;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-time {
  font-size: 28rpx;
  color: #666666;
}

.order-amount {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.order-status-wrapper {
  display: flex;
  align-items: center;
}

/* 订单主体 */
.order-body {
  padding: 20rpx 24rpx;
}

.order-payment-status {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.payment-status-label {
  margin-right: 8rpx;
}

.payment-status-value {
  font-weight: 600;
  color: #003183;
}

.order-table {
  margin-bottom: 16rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background-color: #f5f5f5;
  border-bottom: 1rpx solid #e0e0e0;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-col {
  padding: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.table-col-name {
  flex: 2;
  color: #333333;
  font-weight: 600;
}

.table-col-count {
  flex: 1;
  color: #333333;
  text-align: center;
}

.table-col-unit {
  flex: 1;
  color: #666666;
  text-align: center;
}

.table-col-total {
  flex: 1;
  color: #ff5722;
  font-weight: 600;
  text-align: right;
}

.table-header .table-col {
  font-weight: 700;
  color: #333333;
  background-color: #f5f5f5;
}

.order-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.total-price {
  color: #ff5722;
  font-size: 32rpx;
}

/* 订单操作 */
.order-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.mini-btn {
  margin: 0 !important;
}

.mini-btn.weui-btn_primary {
  background-color: #003183 !important;
  color: #ffffff !important;
  font-weight: 600 !important;
  padding: 16rpx 32rpx !important;
  font-size: 28rpx !important;
  min-width: 160rpx;
}

.mini-btn.weui-btn_default {
  color: #666666 !important;
  border-color: #dddddd !important;
  font-weight: 600 !important;
  padding: 16rpx 32rpx !important;
  font-size: 28rpx !important;
  min-width: 160rpx;
}

.cancel-btn {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%) !important;
  border: 2rpx solid #dee2e6 !important;
  color: #6c757d !important;
  transition: all 0.3s ease;
}

.cancel-btn:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%) !important;
  transform: scale(0.98);
}

/* 订单状态徽章样式 */
.order-status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  min-width: 120rpx;
}

.order-status-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1;
}

/* WeUI徽章样式 */
.weui-badge {
  background-color: #003183 !important;
}
