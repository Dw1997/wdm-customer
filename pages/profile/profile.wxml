<!--profile.wxml-->
<view class="page">
  <!-- 个人信息头部 -->
  <view class="profile-header">
    <view class="profile-bg"></view>
    <view class="profile-content">
      <view class="profile-info">
        <text class="profile-name">{{customerInfo.isBound ? customerInfo.name : '未绑定店铺'}}</text>
        <text class="profile-phone">{{userInfo.phone || '138****8888'}}</text>
      </view>
      <view class="profile-edit" bindtap="editProfile">
        <text class="edit-text">编辑</text>
      </view>
    </view>
  </view>

  <!-- 统计信息卡片 -->
  <view class="stats-card">
    <view class="stat-item unsettled">
      <text class="stat-label">未结算</text>
      <text class="stat-value">{{stats.unsettledAmount}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item total-orders">
      <text class="stat-label">本月总订单</text>
      <text class="stat-value">{{stats.monthlyTotalOrders}}</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item total-amount">
      <text class="stat-label">本月总消费</text>
      <text class="stat-value">{{stats.monthlyTotalConsumption}}</text>
    </view>
  </view>

  <!-- 我的服务 - 九宫格形式 -->
  <view class="service-section">
    <view class="section-title">我的服务</view>
    <view class="service-grid">
      <view class="service-item" bindtap="contactService">
        <view class="service-icon" style="background-color: #fff7e6;">
          <text class="icon-char">联</text>
        </view>
        <text class="service-label">联系我们</text>
      </view>
      <view class="service-item" bindtap="goToAbout">
        <view class="service-icon" style="background-color: #f6ffed;">
          <mp-icon icon="info" color="#52c41a" size="48"></mp-icon>
        </view>
        <text class="service-label">关于我们</text>
      </view>
    </view>
  </view>

  <!-- 设置板块 -->
  <view class="settings-section">
    <view class="section-title">设置</view>
    <view class="settings-list">
      <view class="setting-item" bindtap="goToAddress">
        <view class="setting-icon" style="background-color: #e6f7ff;">
          <text class="icon-char">址</text>
        </view>
        <text class="setting-label">收货地址</text>
        <mp-icon icon="arrow" color="#c8c8cd" size="24"></mp-icon>
      </view>
    </view>
  </view>



</view>
