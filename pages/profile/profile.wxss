/* profile.wxss */
.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 个人信息头部 */
.profile-header {
  position: relative;
  padding: 60rpx 30rpx 60rpx;
  overflow: hidden;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #003183 0%, #4a90e2 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.profile-content {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.profile-info {
  flex: 1;
  text-align: left;
  margin: 0 30rpx 0 0;
}

.profile-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 16rpx;
  display: block;
}

.profile-phone {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
}

.profile-edit {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 统计信息卡片 */
.stats-card {
  margin: -20rpx 30rpx 30rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding: 20rpx 0;
}

/* 未结算样式 */
.stat-item.unsettled .stat-value {
  color: #ff6b6b;
}

.stat-item.unsettled .stat-label {
  color: #ff6b6b;
}

/* 总订单样式 */
.stat-item.total-orders .stat-value {
  color: #003183;
}

.stat-item.total-orders .stat-label {
  color: #003183;
}

/* 总消费样式 */
.stat-item.total-amount .stat-value {
  color: #52c41a;
}

.stat-item.total-amount .stat-label {
  color: #52c41a;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 30rpx;
  font-weight: 600;
}

.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #f0f0f0;
}

/* 通用标题样式 */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
  padding: 30rpx 30rpx 20rpx;
}

/* 我的服务 - 九宫格 */
.service-section {
  margin-bottom: 20rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 30rpx 20rpx;
}

.service-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}

.service-item:active {
  transform: scale(0.98);
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.service-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
}

/* 设置板块 */
.settings-section {
  margin-bottom: 40rpx;
}

.settings-list {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin: 0 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.setting-label {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 退出登录区域 */
.logout-section {
  padding: 40rpx 30rpx;
}

.weui-btn_warn {
  background-color: #ff4d4f !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
}

/* 顶部提示 */
.mp-toptips {
  z-index: 9999;
}
