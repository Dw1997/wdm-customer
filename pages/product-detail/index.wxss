.detail-page {
  padding-bottom: 160rpx;
}

.gallery,
.gallery-img {
  width: 100%;
  height: 520rpx;
}

.gallery-placeholder {
  width: 100%;
  height: 420rpx;
  background: linear-gradient(145deg, #EBF2FC, #DCE8F9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
}

.ph-text {
  font-size: var(--fs-xl);
  font-weight: 800;
  color: var(--primary);
}

.ph-sub {
  margin-top: 12rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
}

.wrap {
  padding: 20rpx 24rpx 0;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.main-price {
  color: var(--price);
  font-weight: 800;
}

.yen {
  font-size: 30rpx;
}

.num {
  font-size: var(--fs-price-lg);
}

.unit {
  font-size: var(--fs-sm);
  color: var(--muted);
  font-weight: 600;
  margin-left: 6rpx;
}

.share-btn {
  margin: 0;
  padding: 0 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid var(--line);
  font-size: var(--fs-sm);
  font-weight: 700;
  color: var(--ink);
}

.share-btn::after {
  border: none;
}

.p-title {
  margin-top: 18rpx;
  font-size: var(--fs-xl);
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
}

.p-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-tag {
  background: var(--bg);
  color: var(--muted);
  font-size: var(--fs-xs);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
}

.sku-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 2rpx solid #EEF2F7;
  gap: 16rpx;
}

.sku-row:first-of-type {
  border-top: none;
}

.sku-spec {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
}

.sku-pr {
  margin-top: 8rpx;
  font-size: var(--fs-price);
  font-weight: 800;
  color: var(--price);
}

.sku-unit {
  font-size: var(--fs-xs);
  color: var(--muted);
  font-weight: 500;
}

.sku-hid {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
}

.desc-txt {
  font-size: var(--fs-md);
  color: #334155;
  line-height: 1.75;
}

.foot-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top: 2rpx solid var(--line);
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.foot-l {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.cart-badge-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-ico {
  font-size: 40rpx;
}

.c-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: var(--price);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.f-sum {
  font-size: var(--fs-price);
  font-weight: 800;
  color: var(--price);
}

.f-sub {
  font-size: var(--fs-xs);
  color: var(--muted);
}

.go-cart-btn {
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--fs-lg);
  font-weight: 700;
  padding: 22rpx 46rpx;
  border-radius: 44rpx;
}

/* 底部弹出购物车半屏卡片 */
.cart-sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 25, 42, 0.52);
  z-index: 800;
  display: flex;
  align-items: flex-end;
}

.cart-sheet-panel {
  width: 100%;
  max-height: 76vh;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 28rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.cart-sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.cart-sheet-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.cart-sheet-title {
  font-size: var(--fs-lg);
  font-weight: 800;
  color: var(--ink);
}

.cart-sheet-count {
  font-size: var(--fs-sm);
  color: var(--muted);
  font-weight: 600;
}

.cart-sheet-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--bg);
  color: #465468;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.cart-sheet-scroll {
  max-height: 46vh;
  padding: 8rpx 0;
}

.cart-item-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #EEF2F7;
}

.cart-item-row:last-child {
  border-bottom: none;
}

.ci-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: var(--primary-soft);
  flex: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ci-img {
  width: 100%;
  height: 100%;
}

.ci-ph {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
}

.ci-info {
  flex: 1;
  min-width: 0;
}

.ci-name {
  font-size: var(--fs-md);
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ci-spec {
  margin-top: 4rpx;
  font-size: var(--fs-xs);
  color: var(--muted);
}

.ci-price {
  margin-top: 6rpx;
  font-size: var(--fs-md);
  font-weight: 800;
  color: var(--price);
}

.ci-yen {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.ci-unit {
  font-size: var(--fs-xs);
  font-weight: 500;
  color: var(--muted);
  margin-left: 4rpx;
}

.cart-sheet-empty {
  padding: 72rpx 24rpx;
  text-align: center;
}

.empty-txt {
  font-size: var(--fs-lg);
  font-weight: 700;
  color: var(--ink);
}

.empty-sub {
  margin-top: 12rpx;
  font-size: var(--fs-sm);
  color: var(--muted);
}

.cart-sheet-ft {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--line);
}

.cs-sum-wrap {
  display: flex;
  flex-direction: column;
}

.cs-sum-label {
  font-size: var(--fs-xs);
  color: var(--muted);
}

.cs-sum-val {
  font-size: var(--fs-price);
  font-weight: 800;
  color: var(--price);
}

.cs-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: none;
}

.cs-continue-btn {
  background: var(--primary-soft);
  color: var(--primary);
  font-size: var(--fs-sm);
  font-weight: 700;
  padding: 20rpx 26rpx;
  border-radius: 40rpx;
}

.cs-go-btn {
  background: var(--primary);
  color: #FFFFFF;
  font-size: var(--fs-md);
  font-weight: 700;
  padding: 20rpx 34rpx;
  border-radius: 40rpx;
}
